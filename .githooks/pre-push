#!/bin/sh
# 1. Refuses a push carrying any commit that is AI-attributed: authored or
#    committed as an AI agent, or a message with an AI co-author trailer or
#    naming an AI model as its author or reviewer (ai_identity.sh).
# 2. Runs the CI suite on this machine; a failure blocks the push.
# Enable once per clone: git config core.hooksPath .githooks
# Skip in an emergency: git push --no-verify
. "$(dirname "$0")/ai_identity.sh"
z=0000000000000000000000000000000000000000
bad=0
while read lref lsha rref rsha; do
    [ "$lsha" = "$z" ] && continue
    if [ "$rsha" = "$z" ]; then range="$lsha"; else range="$rsha..$lsha"; fi
    who=$(git log --format='%h %an <%ae> / %cn <%ce>' "$range" 2>/dev/null \
        | grep -iE "$AI_IDENT")
    if [ -n "$who" ]; then
        echo "pre-push: $lref has commits by an AI identity; not pushing:" >&2
        echo "$who" | head -5 >&2
        bad=1
    fi
    hits=$(git log --format='%h %s%n%b' "$range" 2>/dev/null | grep -ciE "$AI_NAMED")
    if [ "${hits:-0}" -gt 0 ]; then
        echo "pre-push: $lref has AI attribution in a commit message; not pushing" >&2
        bad=1
    fi
done
[ "$bad" = 0 ] || exit 1
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "pre-push: running scripts/ci.sh locally"
bash scripts/ci.sh
