# The GUI ships as gui_static/index.html; its source (bench/: bench.html, build
# script, source JSON) stays in the repo.
prune src/vqlab/agents/gui_static/bench
# The private notebook never ships.
prune lab
# The sdist carries the whole test suite (conftest, fixtures, goldens), so
# `pytest` runs from an unpacked sdist.
graft tests
# The docs, changelog and citation the README and metadata point at.
graft docs
include CHANGELOG.md CITATION.cff
global-exclude __pycache__ *.py[cod]
