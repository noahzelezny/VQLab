       "0,30",
       "--dim",
       "4",
       "--k",
       "256",
       "--family",
       "qwen3_5",
       "--seed",
       "1234",
       "--pack",
       "--tail-from",
       "30",
       "--tail-geom",
       "d8k4096",
       "--relerr-abort",
       "0.45"
      ],
      "writes_gib": 3.6
     },
     "retries": 3,
     "timeout_s": 172800,
     "expect": {
      "files": [
       "<scratch>/moe-sz-big/moe-sz-big/config.json"
      ]
     }
    },
    {
     "name": "vision",
     "cmd": "graft",
