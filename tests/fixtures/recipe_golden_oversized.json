     "name": "struct-base",
     "cmd": "stream-convert",
     "args": [
      "--src",
      "<tmp>/teachers/T",
      "--out",
      "<scratch>/moe-sz-big/struct",
      "--struct",
      "--protect-bits",
      "8",
      "--family",
      "qwen3_5",
      "--cpu-load"
     ],
     "preflight": {
      "full": "the fit needs the whole struct base",
      "writes_gib": 3.6
     },
     "retries": 1,
     "timeout_s": 21600,
     "expect": {
      "files": [
       "<scratch>/moe-sz-big/struct/config.json"
      ]
     }
    },
    {
     "name": "fit",
     "cmd": "fit-moe",
