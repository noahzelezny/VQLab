      "full": "a read-only check",
      "writes_gib": 0
     },
     "retries": 0,
     "timeout_s": 600
    },
    {
     "name": "knurlogic-link",
     "cmd": "knurlogic-link",
     "args": [
      "<scratch>/moe-sz-big/moe-sz-big-sz"
     ],
     "preflight": {
      "full": "one symlink in the Knurlogic models dir, no data",
      "writes_gib": 0
     },
     "gpu": false,
     "retries": 0,
     "timeout_s": 600
    },
    {
     "name": "release-check",
     "cmd": "check-release",
     "args": [
      "--artifact",
      "<scratch>/moe-sz-big/moe-sz-big-sz",
      "--tokenizer-ref",
      "<tmp>/teachers/T/tokenizer.json",
      "--knurlogic-smoke",
      "fit"
     ],
     "preflight": {
      "full": "loads the artifact on the cluster through Knurlogic; fails if Knurlogic or the cluster is down",
      "writes_gib": 0
     },
     "retries": 0,
     "timeout_s": 7200
    },
    {
     "name": "score",
     "cmd": "kl-ladder",
     "args": [
      "--cache",
      "prose=/c/prose",
      "--rung",
      "moe-sz-big=<scratch>/moe-sz-big/pin",
      "--per-pos-dir",
      "<scratch>/moe-sz-big/kl-per-pos",
      "--out",
      "<scratch>/moe-sz-big/kl.json",
      "--lazy-over-gb",
      "16"
     ],
     "preflight": {
      "append": [
       "--preflight"
      ]
     },
     "retries": 1,
     "timeout_s": 43200,
     "expect": {
      "stdout_regex": "KL",
      "files": [
       "<scratch>/moe-sz-big/kl.json"
      ]
     }
    }
   ]
