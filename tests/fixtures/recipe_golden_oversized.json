      "--base",
      "<scratch>/moe-sz-big/struct",
      "--src",
      "<tmp>/teachers/T",
      "--out",
      "<scratch>/moe-sz-big/moe-sz-big",
      "--vq-layers",
      "0-39",
      "--dim",
      "4",
      "--k",
      "256",
      "--family",
      "qwen3_5",
      "--seed",
      "1234",
      "--pack",
      "--tail-from",
      "30",
      "--tail-geom",
      "d8k4096",
      "--relerr-abort",
      "0.45"
     ],
     "preflight": {
      "args": [
       "--base",
       "<scratch>/moe-sz-big/struct",
       "--src",
       "<tmp>/teachers/T",
       "--out",
       "<scratch>/moe-sz-big/moe-sz-big",
       "--vq-layers",
       "0,30",
       "--dim",
       "4",
       "--k",
       "256",
       "--family",
       "qwen3_5",
       "--seed",
       "1234",
       "--pack",
       "--tail-from",
       "30",
       "--tail-geom",
       "d8k4096",
       "--relerr-abort",
       "0.45"
      ],
      "writes_gib": 3.6
     },
     "retries": 3,
     "timeout_s": 172800,
     "expect": {
      "files": [
       "<scratch>/moe-sz-big/moe-sz-big/config.json"
      ]
     }
    },
    {
     "name": "vision",
     "cmd": "graft",
     "args": [
      "--artifact",
      "<scratch>/moe-sz-big/moe-sz-big",
      "--src",
      "<tmp>/teachers/T",
      "--dest-prefix",
      "vision_tower",
      "--permute-conv5"
     ],
     "preflight": {
      "full": "grafts the tower in place",
      "writes_gib": 1.3
     },
     "retries": 0,
     "timeout_s": 3600
    },
    {
     "name": "skipzero",
     "cmd": "sz-pack",
     "args": [
      "<scratch>/moe-sz-big/moe-sz-big",
      "--out",
      "<scratch>/moe-sz-big/moe-sz-big-sz"
     ],
     "preflight": {
      "append": [
       "--layers",
       "0-0"
      ]
     },
     "gpu": false,
     "retries": 0,
     "timeout_s": 21600,
     "expect": {
      "files": [
       "<scratch>/moe-sz-big/moe-sz-big-sz/config.json"
      ]
     }
    },
    {
     "name": "skipzero-check",
     "cmd": "sz-check",
     "args": [
      "<scratch>/moe-sz-big/moe-sz-big-sz",
      "<scratch>/moe-sz-big/moe-sz-big"
     ],
     "preflight": {
      "full": "numpy check, reads only",
      "writes_gib": 0
     },
     "gpu": false,
     "retries": 0,
     "timeout_s": 10800
    },
    {
     "name": "skipzero-bundle",
     "cmd": "bundle",
     "args": [
      "--artifact",
      "<scratch>/moe-sz-big/moe-sz-big-sz"
     ],
     "preflight": {
      "full": "rewrites model.py and config.json, no weights",
      "writes_gib": 0
     },
     "retries": 0,
     "timeout_s": 1800
    },
    {
     "name": "smoke",
     "cmd": "pin",
     "args": [
      "<scratch>/moe-sz-big/moe-sz-big-sz",
      "--out",
      "<scratch>/moe-sz-big/pin",
      "--max-tokens",
      "8"
     ],
     "preflight": {
      "full": "a pin is symlinks plus an 8-token smoke",
      "writes_gib": 0
     },
     "retries": 0,
     "timeout_s": 3600
    },
    {
     "name": "runtime-check",
     "cmd": "check-bundle",
     "args": [
      "--artifact",
      "<scratch>/moe-sz-big/moe-sz-big-sz",
      "--strict"
     ],
     "preflight": {
      "full": "a read-only check",
      "writes_gib": 0
     },
     "retries": 0,
     "timeout_s": 600
    },
    {
     "name": "knurlogic-link",
     "cmd": "knurlogic-link",
     "args": [
      "<scratch>/moe-sz-big/moe-sz-big-sz"
     ],
     "preflight": {
      "full": "one symlink in the Knurlogic models dir, no data",
      "writes_gib": 0
     },
     "gpu": false,
     "retries": 0,
     "timeout_s": 600
    },
    {
     "name": "release-check",
     "cmd": "check-release",
     "args": [
      "--artifact",
      "<scratch>/moe-sz-big/moe-sz-big-sz",
      "--tokenizer-ref",
      "<tmp>/teachers/T/tokenizer.json",
      "--knurlogic-smoke",
      "fit"
     ],
     "preflight": {
      "full": "loads the artifact on the cluster through Knurlogic; fails if Knurlogic or the cluster is down",
      "writes_gib": 0
     },
     "retries": 0,
     "timeout_s": 7200
    },
    {
     "name": "score",
     "cmd": "kl-ladder",
     "args": [
      "--cache",
      "prose=/c/prose",
      "--rung",
      "moe-sz-big=<scratch>/moe-sz-big/pin",
      "--per-pos-dir",
      "<scratch>/moe-sz-big/kl-per-pos",
      "--out",
      "<scratch>/moe-sz-big/kl.json",
      "--lazy-over-gb",
      "16"
     ],
     "preflight": {
      "append": [
       "--preflight"
      ]
     },
     "retries": 1,
     "timeout_s": 43200,
     "expect": {
      "stdout_regex": "KL",
      "files": [
       "<scratch>/moe-sz-big/kl.json"
      ]
     }
    }
   ]
