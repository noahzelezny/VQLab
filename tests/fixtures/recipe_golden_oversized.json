      "<scratch>/moe-sz-big/moe-sz-big",
      "--vq-layers",
      "0-39",
      "--dim",
      "4",
      "--k",
      "256",
      "--family",
      "qwen3_5",
      "--seed",
      "1234",
      "--pack",
